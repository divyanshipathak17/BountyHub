# Copy to .env and adjust as needed
PORT=5000
MONGO_URI=mongodb://localhost:27017/bountyhub
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
STARTER_TOKENS=100
BCRYPT_ROUNDS=10
# How often (ms) un-accepted bounties are checked for expiry/refund
EXPIRY_SWEEP_MS=30000

# Set to 'memory' to run without MongoDB (demo only, nothing is persisted)
# STORAGE=memory
